<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ventas Web</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

    <style>
        :root {
            --sidebar-width: 260px;
            --sidebar-collapsed-width: 70px;
            --main-bg: #f4f7f6;
            --accent-color: #0d6efd;
        }

        body {
            background-color: var(--main-bg);
            overflow-x: hidden;
        }

        #wrapper {
            display: flex;
            transition: all 0.3s;
        }

        #sidebar-wrapper {
            min-height: 100vh;
            width: var(--sidebar-width);
            background: #2c3e50;
            color: white;
            transition: all 0.3s;
            z-index: 1000;
        }

        #wrapper.toggled #sidebar-wrapper {
            width: var(--sidebar-collapsed-width);
        }

        #page-content-wrapper {
            width: 100%;
            flex-grow: 1;
        }

        .sidebar-heading {
            padding: 1.5rem 1rem;
            font-size: 1.2rem;
            display: flex;
            align-items: center;
        }

        #wrapper.toggled .sidebar-text {
            display: none !important;
        }

        #wrapper.toggled .sidebar-heading i {
            font-size: 1.5rem;
            margin: 0 auto;
        }

        .nav-link-sidebar {
            color: rgba(255,255,255,0.8);
            padding: 12px 20px;
            display: flex;
            align-items: center;
            text-decoration: none;
            transition: 0.2s;
        }

            .nav-link-sidebar:hover {
                background: rgba(255,255,255,0.1);
                color: white;
            }

        .sidebar-submenu {
            background: rgba(0,0,0,0.2);
            list-style: none;
            padding: 0;
        }

        .top-navbar {
            background: white;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }

        #wrapper.toggled .accordion-button {
            padding-left: 1.5rem;
        }

            #wrapper.toggled .accordion-button::after {
                display: none !important;
            }

        .sidebar-text {
            white-space: nowrap;
            overflow: hidden;
        }
    </style>
</head>

<body>
    <div id="wrapper">
        <div id="sidebar-wrapper">
            <div class="sidebar-heading border-bottom border-secondary">
                <i class="bi bi-grid-fill me-2 text-primary"></i>
                <span class="sidebar-text fw-bold">Ventas Web</span>
            </div>

            <div class="list-group list-group-flush w-100">
                @await Component.InvokeAsync("Menu")
            </div>
        </div>

        <div id="page-content-wrapper">
            <nav class="navbar navbar-expand-lg navbar-light top-navbar py-3 px-4">
                <button class="btn btn-light border shadow-sm me-3" id="menu-toggle" type="button">
                    <i class="bi bi-list"></i>
                </button>

                <div class="ms-auto d-flex align-items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-muted small d-flex align-items-center">
                            <i class="bi bi-shop me-3"></i>
                            @User.FindFirst("Tienda")?.Value
                        </span>
                        <span class="text-muted small d-flex align-items-center">
                            <i class="fas fa-desktop me-1"></i>
                            @User.FindFirst("Estacion")?.Value
                        </span>
                        <span class="text-muted small d-none d-md-flex align-items-center">
                            <i class="bi bi-person-circle me-1"></i>
                            @(User.FindFirst("NombreCompleto")?.Value ?? User.Identity?.Name ?? "Invitado")
                        </span>
                    }

                    <form asp-controller="Login" asp-action="Logout" method="post" class="mb-0">
                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                            <i class="bi bi-box-arrow-right me-1"></i> Salir
                        </button>
                    </form>
                </div>
            </nav>

            <div class="container-fluid p-4">
                <main role="main">
                    <nav aria-label="breadcrumb" class="mb-4">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="#">Inicio</a></li>
                            <li class="breadcrumb-item active">@ViewData["Title"]</li>
                        </ol>
                    </nav>

                    <div class="card border-0 shadow-sm p-4 rounded-4">
                        @RenderBody()
                    </div>
                </main>
            </div>
        </div>
    </div>

    <!-- Scripts comunes (orden correcto) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Flatpickr ANTES de los scripts de la vista -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        $("#menu-toggle").on("click", function (e) {
            e.preventDefault();
            $("#wrapper").toggleClass("toggled");
        });
    </script>

    <!-- Aquí se inyectan los scripts de cada vista -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>