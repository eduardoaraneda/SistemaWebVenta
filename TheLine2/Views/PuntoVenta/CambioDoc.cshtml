        outline: none;
    }

    /* Color azul de la imagen para campos bloqueados */
    .readonly {
        background-color: #b4c7e7 !important;
        border: 1px solid #8da9d6 !important;
    }

    /* Botón Buscar */
    .win-btn-search {
        padding: 2px 15px;
        background: #fff;
