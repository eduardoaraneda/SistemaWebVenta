    }

    .win-btn {
        padding: 5px 20px;
        border: 1px solid #aaa;
        background: #fff;
        border-radius: 3px;
        font-size: 13px;
        cursor: pointer;
    }

        .win-btn:hover {
            background: #e9e9e9;
        }
</style>