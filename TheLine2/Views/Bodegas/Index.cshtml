@{
    ViewData["Title"] = "Bodegas";
    Layout = "_Layout";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <button class="btn btn-secondary" onclick="history.back();">
        <i class="bi bi-arrow-left-circle me-2"></i> Volver
    </button>
</div>
<div class="mb-3">
    <label for="tiendaSelect" class="form-label fw-bold">Seleccionar Tienda</label>
    <select id="tiendaSelect"
            name="Cod_Tienda"
            class="form-select shadow-sm"
            asp-items="ViewBag.Tiendas">
        <option value="">-- Seleccione una sucursal --</option>
    </select>
    <div class="form-text">Elija la tienda para filtrar los datos.</div>
</div>
<div id="contenedorBodegas">
    <div class="text-center py-5">
        <i class="bi bi-info-circle text-info fs-1"></i>
        <p class="text-muted mt-2">Debe seleccionar una tienda para visualizar sus bodegas.</p>
    </div>
</div>
@section Scripts {
    <script>
        $(function () {
            $(document).on('change', 'select[name="Cod_Tienda"]', function () {
                var id = $(this).val();
                console.log("ID Seleccionado: " + id);

                var contenedor = $('#contenedorBodegas');

                if (id && id !== "") {
                    contenedor.html('<div class="text-center py-4"><div class="spinner-border text-primary"></div><p>Cargando...</p></div>');

                    $.ajax({
                        url: '@Url.Action("GetBodegasByTienda", "Bodegas")',
                        type: 'GET',
                        data: { tiendaId: id },
                        success: function (result) {
                            contenedor.html(result);
                        },
                        error: function (xhr, status, error) {
                            console.error("Error AJAX:", error);
                            contenedor.html('<div class="alert alert-danger">Error al conectar con el servidor.</div>');
                        }
                    });
                } else {
                    contenedor.html('<div class="alert alert-info">Seleccione una tienda para ver resultados.</div>');
                }
            });
        });
    </script>
}